          "cookies": [],
          "content": {
            "size": 19124,
            "mimeType": "application/json",
            "text": "[{\"id\":\"201016a8-f199-4c65-9a3e-3f4aa3d0aeef\",\"author_id\":\"2ad72157-a04a-4d6b-aaca-2e4600544079\",\"type\":\"thought\",\"title\":\"To expect is to disappoint\",\"content\":\"The funny thing though, is how expectation just sets you up for this inevitable letdown every single time, as if the mere act of imagining how something will go automatically guarantees that reality will feel hollow and off, transforming perfectly fine moments into disappointments simply because they existed first as fantasies in your head.\",\"visibility\":\"public\",\"created_at\":\"2026-01-27T20:40:18.905811+00:00\",\"updated_at\":\"2026-01-27T20:40:18.905811+00:00\",\"content_warning\":null,\"community_id\":null,\"is_pinned\":false,\"pinned_at\":null,\"pinned_by\":null,\"status\":\"published\",\"styling\":null,\"post_location\":null,\"metadata\":null,\"spotify_track\":null,\"styling\":null,\"post_location\":null,\"metadata\":null,\"author\":{\"id\": \"2ad72157-a04a-4d6b-aaca-2e4600544079\", \"username\": \"hadi\", \"avatar_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/avatars/2ad72157-a04a-4d6b-aaca-2e4600544079-1767897991170.jpg\", \"is_private\": false, \"is_verified\": false, \"display_name\": \"Hadi Itani\"},\"media\":[],\"community\":null,\"admires\":[{\"count\": 0}],\"comments\":[{\"count\": 0}],\"relays\":[{\"count\": 0}]}, \n {\"id\":\"6e7bc59b-4aff-45c1-8137-6600ed15a734\",\"author_id\":\"2ad72157-a04a-4d6b-aaca-2e4600544079\",\"type\":\"thought\",\"title\":\"Recommend me\",\"content\":\"a perfect way to spend a staycation in Jeddah\",\"visibility\":\"public\",\"created_at\":\"2026-01-21T13:36:50.769388+00:00\",\"updated_at\":\"2026-01-21T13:36:50.769388+00:00\",\"content_warning\":null,\"community_id\":null,\"is_pinned\":false,\"pinned_at\":null,\"pinned_by\":null,\"status\":\"published\",\"styling\":null,\"post_location\":null,\"metadata\":null,\"spotify_track\":null,\"styling\":null,\"post_location\":null,\"metadata\":null,\"author\":{\"id\": \"2ad72157-a04a-4d6b-aaca-2e4600544079\", \"username\": \"hadi\", \"avatar_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/avatars/2ad72157-a04a-4d6b-aaca-2e4600544079-1767897991170.jpg\", \"is_private\": false, \"is_verified\": false, \"display_name\": \"Hadi Itani\"},\"media\":[],\"community\":null,\"admires\":[{\"count\": 0}],\"comments\":[{\"count\": 0}],\"relays\":[{\"count\": 0}]}, \n {\"id\":\"6a24ca9a-4e71-483f-9282-73409d029765\",\"author_id\":\"ef23830c-9f03-4c88-86ae-87ba35aba6eb\",\"type\":\"thought\",\"title\":\"heheh3123123123\",\"content\":\"3213123123\",\"visibility\":\"public\",\"created_at\":\"2026-01-19T13:21:23.235527+00:00\",\"updated_at\":\"2026-01-19T13:21:23.235527+00:00\",\"content_warning\":null,\"community_id\":null,\"is_pinned\":false,\"pinned_at\":null,\"pinned_by\":null,\"status\":\"published\",\"styling\":null,\"post_location\":null,\"metadata\":null,\"spotify_track\":null,\"styling\":null,\"post_location\":null,\"metadata\":null,\"author\":{\"id\": \"ef23830c-9f03-4c88-86ae-87ba35aba6eb\", \"username\": \"poet\", \"avatar_url\": null, \"is_private\": false, \"is_verified\": false, \"display_name\": \"poet\"},\"media\":[],\"community\":null,\"admires\":[{\"count\": 0}],\"comments\":[{\"count\": 0}],\"relays\":[{\"count\": 0}]}, \n {\"id\":\"1219855b-95cd-49a5-a3c6-2249e03d93a4\",\"author_id\":\"ef23830c-9f03-4c88-86ae-87ba35aba6eb\",\"type\":\"thought\",\"title\":\"hehehehe\",\"content\":\"dwadawdawda\",\"visibility\":\"public\",\"created_at\":\"2026-01-19T13:16:29.485509+00:00\",\"updated_at\":\"2026-01-19T13:16:29.485509+00:00\",\"content_warning\":null,\"community_id\":null,\"is_pinned\":false,\"pinned_at\":null,\"pinned_by\":null,\"status\":\"published\",\"styling\":null,\"post_location\":null,\"metadata\":null,\"spotify_track\":null,\"styling\":null,\"post_location\":null,\"metadata\":null,\"author\":{\"id\": \"ef23830c-9f03-4c88-86ae-87ba35aba6eb\", \"username\": \"poet\", \"avatar_url\": null, \"is_private\": false, \"is_verified\": false, \"display_name\": \"poet\"},\"media\":[],\"community\":null,\"admires\":[{\"count\": 0}],\"comments\":[{\"count\": 0}],\"relays\":[{\"count\": 0}]}, \n {\"id\":\"5592d872-dc2a-42df-a258-6117c3308d8d\",\"author_id\":\"daffbe18-3340-4f15-a63b-4916f9be094a\",\"type\":\"story\",\"title\":\"We are soo creative boyyy\",\"content\":\"hehehehehe\",\"visibility\":\"public\",\"created_at\":\"2026-01-18T13:09:27.502924+00:00\",\"updated_at\":\"2026-01-18T13:09:27.502924+00:00\",\"content_warning\":null,\"community_id\":null,\"is_pinned\":false,\"pinned_at\":null,\"pinned_by\":null,\"status\":\"published\",\"styling\":null,\"post_location\":null,\"metadata\":null,\"spotify_track\":null,\"styling\":null,\"post_location\":null,\"metadata\":null,\"author\":{\"id\": \"daffbe18-3340-4f15-a63b-4916f9be094a\", \"username\": \"poet1\", \"avatar_url\": \"/defaultprofile.png\", \"is_private\": false, \"is_verified\": false, \"display_name\": \"jane doe\"},\"media\":[],\"community\":null,\"admires\":[{\"count\": 0}],\"comments\":[{\"count\": 0}],\"relays\":[{\"count\": 0}]}, \n {\"id\":\"43c2c29b-9b24-42c9-98e2-125111914d30\",\"author_id\":\"2ad72157-a04a-4d6b-aaca-2e4600544079\",\"type\":\"journal\",\"title\":null,\"content\":\"Why must we suffer for their mistakes?\",\"visibility\":\"public\",\"created_at\":\"2026-01-18T08:51:55.184015+00:00\",\"updated_at\":\"2026-01-18T08:51:55.184015+00:00\",\"content_warning\":null,\"community_id\":null,\"is_pinned\":false,\"pinned_at\":null,\"pinned_by\":null,\"status\":\"published\",\"styling\":null,\"post_location\":\"Vibes\",\"metadata\":{\"weather\": \"sunny\", \"timeOfDay\": \"morning\", \"temperature\": \"28°C\"},\"spotify_track\":null,\"styling\":null,\"post_location\":\"Vibes\",\"metadata\":{\"weather\": \"sunny\", \"timeOfDay\": \"morning\", \"temperature\": \"28°C\"},\"author\":{\"id\": \"2ad72157-a04a-4d6b-aaca-2e4600544079\", \"username\": \"hadi\", \"avatar_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/avatars/2ad72157-a04a-4d6b-aaca-2e4600544079-1767897991170.jpg\", \"is_private\": false, \"is_verified\": false, \"display_name\": \"Hadi Itani\"},\"media\":[],\"community\":null,\"admires\":[{\"count\": 0}],\"comments\":[{\"count\": 2}],\"relays\":[{\"count\": 0}]}, \n {\"id\":\"5610cf19-baea-4e55-95c3-5f3d4f3cf2b6\",\"author_id\":\"2ad72157-a04a-4d6b-aaca-2e4600544079\",\"type\":\"thought\",\"title\":\"The Times They Are A-Changin'\",\"content\":\"<div>Come writers and critics <span style=\\\"font-size: 1.1rem;\\\">Who prophesize with your pen </span><span style=\\\"font-size: 1.1rem;\\\">And keep your eyes wide </span><span style=\\\"font-size: 1.1rem;\\\">The chance won't come again </span><span style=\\\"font-size: 1.1rem;\\\">And don't speak too soon </span><span style=\\\"font-size: 1.1rem;\\\">For the wheel's still in spin </span><span style=\\\"font-size: 1.1rem;\\\">And there's no tellin' who </span><span style=\\\"font-size: 1.1rem;\\\">That it's namin' </span><span style=\\\"font-size: 1.1rem;\\\">For the loser now </span><span style=\\\"font-size: 1.1rem;\\\">Will be later to win </span><span style=\\\"font-size: 1.1rem;\\\">For the times they are a-changin'</span></div><div><br></div>\",\"visibility\":\"public\",\"created_at\":\"2026-01-17T15:09:27.352802+00:00\",\"updated_at\":\"2026-01-17T15:09:27.352802+00:00\",\"content_warning\":null,\"community_id\":null,\"is_pinned\":false,\"pinned_at\":null,\"pinned_by\":null,\"status\":\"published\",\"styling\":null,\"post_location\":null,\"metadata\":null,\"spotify_track\":null,\"styling\":null,\"post_location\":null,\"metadata\":null,\"author\":{\"id\": \"2ad72157-a04a-4d6b-aaca-2e4600544079\", \"username\": \"hadi\", \"avatar_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/avatars/2ad72157-a04a-4d6b-aaca-2e4600544079-1767897991170.jpg\", \"is_private\": false, \"is_verified\": false, \"display_name\": \"Hadi Itani\"},\"media\":[],\"community\":null,\"admires\":[{\"count\": 0}],\"comments\":[{\"count\": 1}],\"relays\":[{\"count\": 0}]}, \n {\"id\":\"240b2348-10ee-49ea-a664-f9d344086802\",\"author_id\":\"2ad72157-a04a-4d6b-aaca-2e4600544079\",\"type\":\"thought\",\"title\":\"Testing the story share method\",\"content\":\"move along\",\"visibility\":\"public\",\"created_at\":\"2026-01-17T15:00:47.86545+00:00\",\"updated_at\":\"2026-01-17T15:00:47.86545+00:00\",\"content_warning\":null,\"community_id\":null,\"is_pinned\":false,\"pinned_at\":null,\"pinned_by\":null,\"status\":\"published\",\"styling\":null,\"post_location\":null,\"metadata\":null,\"spotify_track\":null,\"styling\":null,\"post_location\":null,\"metadata\":null,\"author\":{\"id\": \"2ad72157-a04a-4d6b-aaca-2e4600544079\", \"username\": \"hadi\", \"avatar_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/avatars/2ad72157-a04a-4d6b-aaca-2e4600544079-1767897991170.jpg\", \"is_private\": false, \"is_verified\": false, \"display_name\": \"Hadi Itani\"},\"media\":[],\"community\":null,\"admires\":[{\"count\": 0}],\"comments\":[{\"count\": 0}],\"relays\":[{\"count\": 0}]}, \n {\"id\":\"580cd4bb-2d86-4334-b056-3054318ee1ba\",\"author_id\":\"2ad72157-a04a-4d6b-aaca-2e4600544079\",\"type\":\"journal\",\"title\":\"Tales from the Boredomlands\",\"content\":\"It was a hot June day in 2017. I'd been back in Jeddah for a week only. Steam summer sales were on, and prices were so low. I had a visa card with 200 dollars on it that I could only use online. I was like you know what, fuck it, I am going shopping bitches.. but like sitting on my ass on the computer browsing steam<span style=\\\"color: rgb(10, 10, 10); font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px;\\\">. </span>I started buying games that I didn't even know or want. I obviously didn't even play 10% of the games I bought that day and they remained in my steam library for years collecting digital dust? idk. One of these games was \\\"tales from the borderlands\\\".. a hidden treasure that I would yet discover. <span style=\\\"font-size: 1.1rem;\\\">Fast forward to last week, a boring Thursday evening, nothing to do. I decided to go through my steam library, hoping to find something that would quench the thirst that is my boredom. I see tales from the borderlands.. hmm looks interesting, why not give it a shot. I download the game, and start playing..</span><div><br><div>What followed was a week of a marvelously captivating journey of inspiration, laughter that could cure depression, a connection to a character that truly resonated with me on a borderline weird level. The writing, art direction, character chemistry and development, choices that actually respect your choices and not just a filler illusion that you impacted the story.. everything about this game was perfect.</div><div><br></div><div>It didn't take long for me to get hooked, <i>mini spoilers</i> ahead I mean the scene with Rhys getting prompted to assistant Vice janitor was a masterclass of comedic delivery.. Or during episode 4 intro, the 4-way staring scene.. </div><div><br></div><div>but what really hooked me to the game? I guess despite everything, I saw a glimpse of myself in this story.. a person desperately trying to climbing the corporate ladder but despite everything deep down, wants to truly create a positive change.. for everyone. and to me that connection revived a part of me that was dormant for so long. to actually make a positive change somehow or at least inspire others to do so.</div><div><br></div><div>I guess you can say, I still got some fight in me..</div></div>\",\"visibility\":\"public\",\"created_at\":\"2026-01-16T21:59:52.53662+00:00\",\"updated_at\":\"2026-01-16T21:59:52.53662+00:00\",\"content_warning\":null,\"community_id\":null,\"is_pinned\":false,\"pinned_at\":null,\"pinned_by\":null,\"status\":\"published\",\"styling\":{\"dropCap\": false, \"background\": {\"type\": \"pattern\", \"value\": \"radial-gradient(ellipse at 20% 80%, rgba(142, 68, 173, 0.1) 0%, transparent 50%), radial-gradient(ellipse at 80% 20%, rgba(255, 0, 127, 0.08) 0%, transparent 50%), radial-gradient(ellipse at 50% 50%, rgba(255, 159, 67, 0.06) 0%, transparent 60%), #fdfcfb\"}, \"lineSpacing\": \"normal\", \"textAlignment\": \"left\"},\"post_location\":\"Jeddah <3\",\"metadata\":{\"mood\": \"hopeful\", \"weather\": \"partly-cloudy\", \"temperature\": \"24°C\"},\"spotify_track\":null,\"styling\":{\"dropCap\": false, \"background\": {\"type\": \"pattern\", \"value\": \"radial-gradient(ellipse at 20% 80%, rgba(142, 68, 173, 0.1) 0%, transparent 50%), radial-gradient(ellipse at 80% 20%, rgba(255, 0, 127, 0.08) 0%, transparent 50%), radial-gradient(ellipse at 50% 50%, rgba(255, 159, 67, 0.06) 0%, transparent 60%), #fdfcfb\"}, \"lineSpacing\": \"normal\", \"textAlignment\": \"left\"},\"post_location\":\"Jeddah <3\",\"metadata\":{\"mood\": \"hopeful\", \"weather\": \"partly-cloudy\", \"temperature\": \"24°C\"},\"author\":{\"id\": \"2ad72157-a04a-4d6b-aaca-2e4600544079\", \"username\": \"hadi\", \"avatar_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/avatars/2ad72157-a04a-4d6b-aaca-2e4600544079-1767897991170.jpg\", \"is_private\": false, \"is_verified\": false, \"display_name\": \"Hadi Itani\"},\"media\":[{\"id\": \"edb434d1-4f97-46fc-80e0-4fd70894d73b\", \"caption\": \"The squad\", \"position\": 0, \"media_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/post-media/2ad72157-a04a-4d6b-aaca-2e4600544079/580cd4bb-2d86-4334-b056-3054318ee1ba/0-1768600792863.jpg\", \"media_type\": \"image\"}, {\"id\": \"b2ca8293-fb25-4568-89c4-a61343745156\", \"caption\": \"Only the cutest little robot\", \"position\": 1, \"media_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/post-media/2ad72157-a04a-4d6b-aaca-2e4600544079/580cd4bb-2d86-4334-b056-3054318ee1ba/1-1768600795049.jpeg\", \"media_type\": \"image\"}, {\"id\": \"b606b63b-f677-4f53-8845-7b93e824895d\", \"caption\": \"I hate that this game is ending\", \"position\": 2, \"media_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/post-media/2ad72157-a04a-4d6b-aaca-2e4600544079/580cd4bb-2d86-4334-b056-3054318ee1ba/2-1768600795910.jpeg\", \"media_type\": \"image\"}, {\"id\": \"4685fe16-06a1-44fc-90be-a10c5e69123e\", \"caption\": \"A hero, a friend, a hero.\", \"position\": 3, \"media_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/post-media/2ad72157-a04a-4d6b-aaca-2e4600544079/580cd4bb-2d86-4334-b056-3054318ee1ba/3-1768600796898.jpg\", \"media_type\": \"image\"}],\"community\":null,\"admires\":[{\"count\": 0}],\"comments\":[{\"count\": 4}],\"relays\":[{\"count\": 0}]}, \n {\"id\":\"e949cd17-f531-4a70-9c4d-85cbf01fb7e5\",\"author_id\":\"291696fa-bbca-47e4-a31e-c90ee92dd072\",\"type\":\"thought\",\"title\":\"wdcdawdawcdawda\",\"content\":\"csczsczscf\",\"visibility\":\"public\",\"created_at\":\"2026-01-16T18:57:42.35932+00:00\",\"updated_at\":\"2026-01-16T18:57:42.35932+00:00\",\"content_warning\":null,\"community_id\":null,\"is_pinned\":false,\"pinned_at\":null,\"pinned_by\":null,\"status\":\"published\",\"styling\":{\"dropCap\": false, \"background\": {\"type\": \"solid\", \"value\": \"#dcb8b0\"}, \"lineSpacing\": \"normal\", \"textAlignment\": \"left\"},\"post_location\":null,\"metadata\":null,\"spotify_track\":null,\"styling\":{\"dropCap\": false, \"background\": {\"type\": \"solid\", \"value\": \"#dcb8b0\"}, \"lineSpacing\": \"normal\", \"textAlignment\": \"left\"},\"post_location\":null,\"metadata\":null,\"author\":{\"id\": \"291696fa-bbca-47e4-a31e-c90ee92dd072\", \"username\": \"hello\", \"avatar_url\": \"https://loaitxbibjftsytlgddi.supabase.co/storage/v1/object/public/avatars/291696fa-bbca-47e4-a31e-c90ee92dd072-1767628238550.png\", \"is_private\": false, \"is_verified\": false, \"display_name\": \"hi\"},\"media\":[],\"community\":null,\"admires\":[{\"count\": 0}],\"comments\":[{\"count\": 0}]
# App
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Payments
PAYMENTS_PROVIDER=stripe
NEXT_PUBLIC_PAYMENTS_PROVIDER=stripe

# Stripe
# Local development MUST use Stripe TEST keys (pk_test_/sk_test_) and a test-mode
# webhook secret from `stripe listen --forward-to localhost:3000/api/stripe/webhooks`.
# Live keys belong only in the production host env (docs/commissions/02-plan.md, Phase 0).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_TEST_WEBHOOK_SECRET

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Cron protection
CRON_SECRET=CHANGE_ME

# Email (site-wide, Sep 2026). Inert until RESEND_API_KEY is set; the DB posts
# every notification and DM digest to /api/notifications/email with the cron
# secret. EMAIL_FROM must be on the Resend-verified pinkquill.com domain and
# matches the address Supabase Auth already sends from.
RESEND_API_KEY=
EMAIL_FROM="PinkQuill <noreply@pinkquill.com>"
# Signs one-click unsubscribe links (falls back to CRON_SECRET when unset).
EMAIL_UNSUBSCRIBE_SECRET=
